<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Package sources for this repository.

    `<clear />` makes this file the single source of truth: without it the
    machine-level ~/.nuget/NuGet/NuGet.Config would contribute its own
    sources and the effective source list would differ between a developer
    machine and CI.

    Package source mapping is required here. Central Package Management
    (Directory.Packages.props) raises NU1507 when more than one source is
    configured without a mapping, and this repository treats warnings as
    errors.

    The `github` source carries credentials, which are NOT stored here:
      - locally   -> merged in from the machine-level NuGet.Config
      - in CI     -> registered by the workflow before restore, using the
                     NUGET_GITHUB_PACKAGES_TOKEN repository secret
    See docs/architecture/sdk-consumption.md.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/yellow-house-studio/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="YellowHouseStudio.Studywise.Sdk" />
    </packageSource>
  </packageSourceMapping>

</configuration>
