    "src/**/*.g.cs",
    "src/**/*.g.i.cs",
    "test/**/bin/**",
    "test/**/obj/**",
    "TestResults/**",
    "docs/**",
    ".git/**"
  ],
  "ignoreRegExpList": [
    "/TestFactory[A-Z_]?\\w+/g",
    "/\\b[A-Z][a-z0-9]+(?:[A-Z][a-z0-9]+)*\\b/g",
    "/\\b[a-z][a-z0-9]*[A-Z][a-zA-Z0-9]*\\b/g",
