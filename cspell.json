    "/\\b[a-z]+_[a-z0-9_]+\\b/g",
    "/\\b_[a-z_]+\\b/g",
    "/\\b[a-z]+\\d+[a-z0-9]*\\b/g",
    "/\\b\\d+[a-z]+\\b/g",
    "/\\b[A-Z]{2,}\\b/g",
    "/\\b[A-Z][a-z0-9]+_[a-z_]+\\b/g"
